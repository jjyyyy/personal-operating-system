OPENAI_API_KEY=your_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMESTAMP_TRANSCRIBE_MODEL=whisper-1
# Optional local/custom provider. Use {audio} where the source path belongs.
# It must print plain transcript text or JSON containing a `text` field.
# VOICE_NOTES_LOCAL_TRANSCRIBE_COMMAND=whisper-cli --file {audio} --json
VOICE_NOTES_TRANSCRIBE_TIMEOUT=600
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# Optional video controls:
# VOICE_NOTES_FFMPEG_PATH=/absolute/path/to/ffmpeg
VOICE_NOTES_VIDEO_SCENE_THRESHOLD=0.28
VOICE_NOTES_VIDEO_MAX_FRAMES=16
VOICE_NOTES_MAX_VIDEO_BYTES=500000000
VOICE_NOTES_INBOX=/Users/jazzzz/Projects/voice-notes/inbox
VOICE_NOTES_NOTIFICATIONS=1
VOICE_NOTES_ICLOUD_TIMEOUT=120
# Keep automatic watched-inbox XHS fetching paused unless account-risk has been reviewed.
# VOICE_NOTES_AUTO_XHS_IMPORTS=1
# VOICE_NOTES_XHS_AUTO_MAX_PER_DAY=2
# VOICE_NOTES_XHS_AUTO_MIN_INTERVAL_SECONDS=21600
